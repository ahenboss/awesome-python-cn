.bar {
  display: flex;
  align-items: center;
}

.input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  font-size: 28rpx;
}

.placeholder {
  color: #98a2b3;
}

.clear {
  margin-left: 16rpx;
  color: #16324f;
  font-size: 26rpx;
}

.hint,
.hit,
.limit {
  display: block;
  margin-top: 24rpx;
  color: #667085;
  font-size: 26rpx;
}

.hit {
  color: #16324f;
  font-weight: 600;
}

.limit {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.cell {
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.name {
  display: block;
  color: #16324f;
  font-size: 30rpx;
  font-weight: 600;
}

.meta {
  display: block;
  margin-top: 6rpx;
  color: #b54708;
  font-size: 22rpx;
}

.desc {
  display: block;
  margin-top: 8rpx;
  color: #475467;
  font-size: 26rpx;
}
