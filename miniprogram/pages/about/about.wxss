.hero {
  padding: 36rpx 32rpx;
  border-radius: 24rpx;
  background: #16324f;
}

.kicker {
  display: block;
  color: #ffd36a;
  font-size: 22rpx;
}

.headline {
  display: block;
  margin-top: 12rpx;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
}

.stats {
  display: block;
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
}

.card {
  margin-top: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.paragraph,
.line {
  display: block;
  color: #1d2939;
  font-size: 28rpx;
  line-height: 1.7;
}

.paragraph + .paragraph,
.line + .line {
  margin-top: 16rpx;
}

.line {
  font-size: 26rpx;
}

.muted {
  color: #98a2b3;
}
