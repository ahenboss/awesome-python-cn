.name {
  display: block;
  padding: 8rpx 8rpx 0;
  color: #16324f;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  margin: 16rpx 0 8rpx;
}

.tag {
  margin: 0 12rpx 12rpx 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #fff6df;
  color: #b54708;
  font-size: 22rpx;
}

.card {
  margin-top: 16rpx;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.label {
  display: block;
  color: #16324f;
  font-size: 24rpx;
  font-weight: 600;
}

.desc,
.url,
.hint {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
}

.desc {
  color: #1d2939;
  line-height: 1.6;
}

.url {
  color: #175cd3;
  font-size: 24rpx;
  word-break: break-all;
}

.hint {
  color: #667085;
  font-size: 24rpx;
}

.btn {
  display: block;
  width: 100%;
  margin-top: 24rpx;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: #16324f;
  color: #ffffff;
  font-size: 28rpx;
  text-align: center;
}

.btn.ghost {
  background: #f3f5f7;
  color: #16324f;
}

.related {
  margin-bottom: 12rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: #ffffff;
}

.related-name {
  display: block;
  color: #16324f;
  font-size: 28rpx;
  font-weight: 600;
}

.related-desc {
  display: block;
  overflow: hidden;
  margin-top: 6rpx;
  color: #667085;
  font-size: 24rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.missing {
  display: block;
  padding: 80rpx 24rpx;
  color: #667085;
  text-align: center;
}
