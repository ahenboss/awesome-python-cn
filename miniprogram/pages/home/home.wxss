.hero {
  padding: 36rpx 32rpx 32rpx;
  border-radius: 24rpx;
  background: #16324f;
}

.slogan {
  display: block;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.35;
}

.tagline {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
}

.stats {
  display: block;
  margin-top: 20rpx;
  color: #ffd36a;
  font-size: 22rpx;
}

.search {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 18rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.search-mark {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ffd36a;
}

.search-text {
  margin-left: 16rpx;
  color: #98a2b3;
  font-size: 28rpx;
}

.hot-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.hot-card {
  width: 340rpx;
  margin-bottom: 16rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.hot-name {
  display: block;
  color: #16324f;
  font-size: 30rpx;
  font-weight: 600;
}

.hot-summary {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.hot-count {
  display: block;
  margin-top: 16rpx;
  color: #b54708;
  font-size: 22rpx;
}

.group {
  margin-bottom: 16rpx;
  padding: 24rpx 20rpx 8rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.group-name {
  display: block;
  color: #16324f;
  font-size: 30rpx;
  font-weight: 600;
}

.group-desc {
  display: block;
  margin-top: 4rpx;
  color: #667085;
  font-size: 22rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.chip {
  display: flex;
  align-items: center;
  margin: 0 12rpx 12rpx 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #f3f5f7;
}

.chip-name {
  color: #1d2939;
  font-size: 24rpx;
}

.chip-count {
  margin-left: 8rpx;
  color: #98a2b3;
  font-size: 22rpx;
}

.footer {
  display: block;
  margin-top: 12rpx;
  color: #98a2b3;
  font-size: 22rpx;
  text-align: center;
}
