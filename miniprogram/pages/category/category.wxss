.head {
  padding: 8rpx 8rpx 20rpx;
}

.name {
  display: block;
  color: #16324f;
  font-size: 40rpx;
  font-weight: 700;
}

.summary {
  display: block;
  margin-top: 12rpx;
  color: #475467;
  font-size: 26rpx;
}

.count {
  display: block;
  margin-top: 12rpx;
  color: #b54708;
  font-size: 22rpx;
}

.filters {
  width: 100%;
  margin-bottom: 8rpx;
  white-space: nowrap;
}

.filter-row {
  display: inline-flex;
  padding-bottom: 8rpx;
}

.filter {
  margin-right: 12rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #475467;
  font-size: 24rpx;
}

.filter.on {
  background: #16324f;
  color: #ffffff;
}

.cell {
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.cell-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.item-name {
  flex: 1;
  color: #16324f;
  font-size: 32rpx;
  font-weight: 600;
}

.section {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #fff6df;
  color: #b54708;
  font-size: 20rpx;
}

.desc {
  display: block;
  margin-top: 10rpx;
  color: #475467;
  font-size: 26rpx;
}

.missing {
  display: block;
  padding: 80rpx 24rpx;
  color: #667085;
  text-align: center;
}
